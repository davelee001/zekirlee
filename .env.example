# Public values are bundled at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Only the selected provider requires a key.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Mainnet account and registered delegate key; the relayer controls the network.
WALRUS_NETWORK=mainnet
WALRUS_MEMORY_SERVER_URL=https://relayer.memory.walrus.xyz
WALRUS_MEMORY_ACCOUNT_ID=
WALRUS_MEMORY_DELEGATE_KEY=
WALRUS_MEMORY_NAMESPACE=zekirlee

